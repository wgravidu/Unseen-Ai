# Immutable hashed build assets (safe on Netlify / Cloudflare Pages)
# Vite already fingerprints these filenames, so cache them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# App shell must revalidate so users get new deploys without a hard refresh.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
