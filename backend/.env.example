# Copy to .env for LOCAL development only. On Render, set these in
# Dashboard > unseen-ai-backend > Environment (never commit a real key).
MODEL_API_KEY=your-meta-ai-api-key
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_NAME=muse-spark-1.3
# Local dev defaults are fine; on the hosted demo we use "*" (stateless backend, no cookies).
CORS_ORIGINS=*
